{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    
    // Add this line right here:
    "skipLibCheck": true
  },
  // And make sure this block exists at the bottom:
  "exclude": [
    "node_modules"
  ]
}