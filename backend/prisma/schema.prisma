generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================= ENUMS =================
enum Role {
  ADMIN
  NURSE
  HEAD_TEACHER
  STUDENT
}

enum PatientType {
  STUDENT
  STAFF
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  IN_CLINIC
  COMPLETED
  REFERRED_TO_HOSPITAL
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

// 👇 BAGONG ENUM PARA SA PROFILE UPDATE REQUESTS
enum ProfileRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
// 👆 ==========================================

// ================= MODELS =================

model User {
  id             String    @id @default(cuid())
  schoolId       String    @unique 
  email          String    @unique 
  
  // BINAGO PARA SA GOOGLE LOGIN
  password       String?   // Ginawang optional
  googleId       String?   @unique // Bagong field para sa Google ID
  
  // 👇 GINAWANG OPTIONAL (?) PARA HINDI MAG-ERROR SA MGA LUMANG ACCOUNTS 👇
  firstName      String?
  lastName       String?
  // 👆 ============================================================== 👆

  role           Role      @default(NURSE)
  isActive       Boolean   @default(true) 
  
  failedLogins   Int       @default(0)    
  lockedUntil    DateTime?                

  handledGrade   String?   
  handledSection String?   

  auditLogs           AuditLog[]                
  referralsMade       Referral[]
  emergenciesRecorded EmergencyIncident[]
  handledVisits       ClinicVisit[] @relation("HandledVisits")
  handledAppointments ClinicRequest[] @relation("HandledAppointments") 

  // 👇 BAGONG RELATIONS PARA SA PROFILE REQUESTS 👇
  profileRequests         ProfileUpdateRequest[] @relation("StudentProfileRequests")
  reviewedProfileRequests ProfileUpdateRequest[] @relation("NurseReviewedRequests")
  // 👆 ========================================= 👆

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// 👇👇👇 BAGONG MODEL PARA SA PROFILE UPDATE REQUESTS 👇👇👇
model ProfileUpdateRequest {
  id                  String               @id @default(cuid())
  
  // Ang estudyanteng nag-request
  userId              String
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  user                User                 @relation("StudentProfileRequests", fields: [userId], references: [id], onDelete: Cascade)

  // Mga impormasyong gustong palitan (optional dahil baka name lang or section lang ang papalitan)
  requestedFirstName  String?
  requestedLastName   String?
  requestedSchoolId   String?
  requestedGradeLevel String?
  requestedSection    String?

  reason              String?              @db.Text
  status              ProfileRequestStatus @default(PENDING)

  // Ang Nurse na nag-approve o nag-reject
  reviewedById        String?
  reviewedBy          User?                @relation("NurseReviewedRequests", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}
// 👆👆👆 ================================================== 👆👆👆


model Patient {
  id              String      @id @default(cuid())
  idNumber        String      @unique 
  type            PatientType @default(STUDENT)
  firstName       String
  lastName        String
  gradeLevel      String?        
  section         String?        
  gender          String
  
  // 👇 FIX: GINAWANG OPTIONAL (?) ANG DATE OF BIRTH 👇
  dateOfBirth     DateTime?
  
  contactNo       String?
  
  clearanceStatus String?     @default("CLEARED")
  
  visits          ClinicVisit[]
  referrals       Referral[]
  clinicRequests  ClinicRequest[]
  
  healthRecord    HealthRecord?
  medicalHistories MedicalHistory[]
  emergencyIncidents EmergencyIncident[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// =====================================================================
// CLINIC VISITS
// =====================================================================
model ClinicVisit {
  id                  String   @id @default(uuid())
  patientId           String
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  nurseId             String?  
  nurse               User?    @relation("HandledVisits", fields: [nurseId], references: [id])
  
  visitDate           DateTime @default(now())
  visitTime           String?  
  visitType           String   @default("General Consultation") 
  
  reason              String   @db.Text 
  symptoms            String?  @db.Text
  
  temperature         Float?
  bloodPressure       String?
  heartRate           Int?
  respiratoryRate     Int?
  oxygenSaturation    Int?
  height              Float?
  weight              Float?

  diagnosis           String?  @db.Text 
  treatment           String?  @db.Text
  medicineUsed        String?  @db.Text
  disposition         String?
  followUpInstructions String? @db.Text
  privateNotes        String?  @db.Text 
  
  status              String   @default("WAITING") 
  isArchived          Boolean  @default(false)

  appointment         ClinicRequest? 

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// =====================================================================
// APPOINTMENTS
// =====================================================================
model ClinicRequest {
  id                 String        @id @default(cuid())
  patientId          String
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  nurseId            String?       
  nurse              User?         @relation("HandledAppointments", fields: [nurseId], references: [id])
  
  type               String        @default("General Consultation") 
  reason             String        @db.Text 
  status             RequestStatus @default(PENDING)
  
  requestDate        DateTime      @default(now()) 
  appointmentDate    DateTime?     
  startTime          DateTime?     
  endTime            DateTime?     
  
  notes              String?       @db.Text 
  cancellationReason String?       @db.Text
  
  clinicVisitId      String?       @unique
  clinicVisit        ClinicVisit?  @relation(fields: [clinicVisitId], references: [id])

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action    String   
  module    String?  
  details   String?  @db.Text
  role      String?  
  ipAddress String?
  
  createdAt DateTime @default(now())
}

model Referral {
  id          String         @id @default(cuid())
  patientId   String
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  referredBy  String?        
  teacher     User?          @relation(fields: [referredBy], references: [id])
  
  referredTo  String?        
  
  reason      String         @db.Text
  urgency     UrgencyLevel   @default(MEDIUM)
  status      ReferralStatus @default(PENDING)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("General")
  description String?  @db.Text
  targetRole  String?  
  
  status      String   @default("ACTIVE") 
  views       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  quantity    Int      @default(0)
  unit        String
  expiryDate  DateTime?
  
  status      String   @default("IN STOCK")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmergencyIncident {
  id           String   @id @default(cuid())
  patientId    String?  
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  incidentType String   
  description  String?  @db.Text
  location     String
  status       String   @default("UNDER OBSERVATION")

  reportedBy   String?  
  reporter     User?    @relation(fields: [reportedBy], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HealthRecord {
  id              String    @id @default(cuid())
  patientId       String    @unique
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bloodType       String?   
  allergies       String?   
  conditionStatus String    @default("HEALTHY") 
  lastCheckup     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  // 👇 FIX: Dinagdag ang onDelete: Cascade
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  condition   String    
  notes       String?   @db.Text 
  dateOrYear  DateTime  
  severity    String    @default("ONGOING") 

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MedicalSupply {
  id          String    @id @default(cuid())
  name        String
  category    String    
  quantity    Int       @default(0)
  unit        String    
  status      String    @default("IN STOCK") 

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  reportId    String   @unique
  name        String
  type        String   
  generatedBy String   @default("Nurse Joy Santos")
  status      String   @default("READY") 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}